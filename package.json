{
    "name":  "sbf-pulse",
    "version":  "1.0.0",
    "private":  true,
    "author":  {
                   "name":  "Kiran",
                   "url":  "https://github.com/Kiranism"
               },
    "scripts":  {
                    "dev":  "next dev",
                    "build":  "next build",
                    "start":  "next start",
                    "typecheck":  "tsc --noEmit",
                    "lint":  "oxlint",
                    "lint:fix":  "oxlint --fix \u0026\u0026 npm run format",
                    "lint:strict":  "oxlint --deny-warnings",
                    "format":  "oxfmt --write . \u0027!**/*.md\u0027 \u0027!**/*.mdc\u0027 \u0027!**/*.mdx\u0027 \u0027!**/*.yml\u0027 \u0027!**/*.yaml\u0027",
                    "format:check":  "oxfmt --check . \u0027!**/*.md\u0027 \u0027!**/*.mdc\u0027 \u0027!**/*.mdx\u0027 \u0027!**/*.yml\u0027 \u0027!**/*.yaml\u0027",
                    "prepare":  "husky"
                },
    "dependencies":  {
                         "@base-ui/react":  "^1.9.0",
                         "@base-ui/utils":  "0.5.0",
                         "@shadcn/react":  "^0.3.1",
                         "@supabase/ssr":  "^0.12.7",
                         "@supabase/supabase-js":  "^2.118.0",
                         "@tabler/icons-react":  "^3.49.0",
                         "@tailwindcss/postcss":  "^4.3.3",
                         "@tanstack/react-form":  "^1.33.5",
                         "@tanstack/react-query":  "^5.104.2",
                         "@tanstack/react-query-devtools":  "^5.104.2",
                         "@tanstack/react-table":  "^9.3.1",
                         "class-variance-authority":  "^0.7.1",
                         "clsx":  "^2.1.1",
                         "cmdk":  "^1.1.1",
                         "date-fns":  "^4.4.0",
                         "next":  "16.4.2",
                         "next-themes":  "^0.4.6",
                         "nextjs-toploader":  "^3.9.17",
                         "postcss":  "8.5.30",
                         "react":  "19.3.0",
                         "react-day-picker":  "^10.0.2",
                         "react-dom":  "19.3.0",
                         "sharp":  "^0.35.5",
                         "sonner":  "^2.0.8",
                         "tailwind-merge":  "^3.7.0",
                         "tailwindcss":  "^4.3.3",
                         "tailwindcss-animate":  "^1.0.7",
                         "vaul":  "^1.1.2",
                         "zod":  "^4.6.7"
                     },
    "devDependencies":  {
                            "@types/node":  "24.19.2",
                            "@types/react":  "19.3.0",
                            "@types/react-dom":  "19.3.0",
                            "husky":  "^9.1.7",
                            "lint-staged":  "^17.6.0",
                            "oxfmt":  "^0.73.0",
                            "oxlint":  "^1.88.0",
                            "tw-animate-css":  "^1.4.0",
                            "typescript":  "7.0.2"
                        },
    "overrides":  {
                      "@types/react":  "19.3.0",
                      "@types/react-dom":  "19.3.0",
                      "postcss":  "8.5.30",
                      "sharp":  "^0.35.5"
                  },
    "lint-staged":  {
                        "!(scripts)/**/*.{js,jsx,tsx,ts,css,less,scss,sass}":  [
                                                                                   "oxfmt --write"
                                                                               ]
                    }
}
